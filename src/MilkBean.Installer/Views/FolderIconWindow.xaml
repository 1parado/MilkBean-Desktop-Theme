<Window x:Class="MilkBean.Installer.Views.FolderIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置文件夹图标" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="为文件夹设置奶豆图标" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="仅修改你选择的文件夹，不会扫描整个磁盘。" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="1. 选择目标文件夹" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <DockPanel Margin="0,8,0,16">
                    <Button DockPanel.Dock="Right" Content="浏览\u2026" Padding="12,6" Click="BtnBrowse_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="FolderPathBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="8,6"/>
                </DockPanel>
                <TextBlock Text="2. 选择图标" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <ListBox x:Name="IconList" Height="140" Margin="0,8,0,0" DisplayMemberPath="Label"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="应用图标" Click="BtnApply_Click"/>
        </StackPanel>
    </Grid>
</Window>
