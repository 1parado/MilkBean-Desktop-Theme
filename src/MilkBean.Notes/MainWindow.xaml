<Window x:Class="MilkBean.Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="奶豆便签" Height="420" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        ResizeMode="CanMinimize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="奶豆便签" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="内容保存在本机，关闭后自动记住" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="新建便签" Padding="16,8" Margin="0,0,8,0" Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" Cursor="Hand" Click="BtnNew_Click"/>
            <Button Content="全部打开" Padding="16,8" Background="#F0E6D3" Foreground="{StaticResource TextBrush}" BorderThickness="0" Cursor="Hand" Click="BtnOpenAll_Click"/>
        </StackPanel>
        <ListBox x:Name="NoteList" Background="{StaticResource CardBrush}" BorderThickness="0" DisplayMemberPath="Title" MouseDoubleClick="NoteList_MouseDoubleClick"/>
    </DockPanel>
</Window>
