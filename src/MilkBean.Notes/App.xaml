<Application x:Class="MilkBean.Notes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FFF8E7"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFDF8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#5C4B3A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A09182"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F5D76E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E8B86D"/>
    </Application.Resources>
</Application>
