; MilkBean Theme - Shared Variables
; Keep colors soft and low-contrast for a calm desktop

[Variables]
; Colors (milkbean palette)
ColorPrimary=245,215,110,255
ColorBackground=255,248,231,230
ColorText=92,75,58,255
ColorAccent=232,184,109,255
ColorToday=245,215,110,255
ColorMuted=160,145,130,200

; Font
FontFace=Segoe UI
FontSizeTime=36
FontSizeDate=14
FontSizeCalendar=12

; Sizes
ClockWidth=220
ClockHeight=90
CalendarWidth=240
CalendarHeight=220

; Update rates
UpdateClock=1000
UpdateCalendar=60000
